# GEMINI_API_KEY: LLM fallback only (NVIDIA first). NOT used for
# speech-to-text — STT runs 100% client-side via the Web Speech API.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Required for NVIDIA Nemotron-3.5-Lightning (nvidia/nemotron-3.5-lightning-30b-a3b)
NVIDIA_API_KEY=""

# PORT: HTTP + WebSocket listen port (default 3000).
PORT="3000"
