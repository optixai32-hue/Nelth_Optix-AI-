{
  "name": "nelth-voice-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nelth-Voice backend only: Edge-TTS speech synthesis + LLM speech turns over HTTP and WebSocket. Speech-to-text runs 100% client-side via the Web Speech API.",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "edge-tts-universal": "^1.4.0",
    "express": "^4.21.2",
    "openai": "^7.10.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
